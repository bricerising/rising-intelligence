// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum Source {
  rss
  news
  hackernews
  reddit
  github
  twitter
}

enum TrendWindow {
  WINDOW_15M
  WINDOW_60M
  WINDOW_24H
}

enum BriefStatus {
  success
  failure
}

// =============================================================================
// Raw Events (Persister writes, Grafana/Trends reads)
// =============================================================================

/// Queryable event archive. Events are immutable once written.
model RawEvent {
  id                  BigInt    @id @default(autoincrement())
  eventId             String    @unique @map("event_id")
  source              Source
  fetchedAt           DateTime  @map("fetched_at") @db.Timestamptz
  publishedAt         DateTime? @map("published_at") @db.Timestamptz

  url                 String?
  title               String?
  text                String

  // Denormalized author info
  authorId            String?   @map("author_id")
  authorHandle        String?   @map("author_handle")
  authorDisplayName   String?   @map("author_display_name")

  // Engagement metrics
  engagementScore     Int?      @map("engagement_score")
  engagementComments  Int?      @map("engagement_comments")
  engagementLikes     Int?      @map("engagement_likes")
  engagementShares    Int?      @map("engagement_shares")

  // Derived fields
  lang                String?
  tags                String[]
  extractedHashtags   String[]  @map("extracted_hashtags")
  extractedUrls       String[]  @map("extracted_urls")
  topics              String[]  // Canonical topic keys (set by Trends backfill or Collector)

  // Free-form metadata
  sourceMeta          Json?     @map("source_meta")

  @@index([source, fetchedAt(sort: Desc)], name: "idx_raw_events_source_fetched")
  @@index([fetchedAt(sort: Desc)], name: "idx_raw_events_fetched")
  @@index([publishedAt(sort: Desc)], name: "idx_raw_events_published")
  @@index([topics], name: "idx_raw_events_topics", type: Gin)
  @@map("raw_events")
}

// Note: Full-text search index (search_vector) is created via raw SQL migration
// because Prisma doesn't support generated columns. See migrations.

// =============================================================================
// Trend Snapshots (Trends writes, Grafana reads)
// =============================================================================

/// Append-only snapshot storage for historical trend charts.
model TrendSnapshot {
  id          BigInt      @id @default(autoincrement())
  generatedAt DateTime    @map("generated_at") @db.Timestamptz
  window      TrendWindow
  snapshot    Json        // Full TrendSnapshot protobuf as JSON

  @@index([generatedAt(sort: Desc)], name: "idx_trend_snapshots_generated")
  @@index([window, generatedAt(sort: Desc)], name: "idx_trend_snapshots_window_generated")
  @@map("trend_snapshots")
}

// =============================================================================
// Brief Results (Brief writes, Grafana reads)
// =============================================================================

/// Stores both success and failure results for audit.
model BriefResult {
  requestId   String      @id @map("request_id")
  producedAt  DateTime    @map("produced_at") @db.Timestamptz
  status      BriefStatus
  result      Json        // Full BriefResult protobuf as JSON

  @@index([producedAt(sort: Desc)], name: "idx_brief_results_produced")
  @@map("brief_results")
}

// =============================================================================
// Consumer Lag (Persister/Trends writes, Trends reads for freshness check)
// =============================================================================

/// Tracks Kafka consumer progress for data freshness validation.
model ConsumerLag {
  consumerGroup String   @map("consumer_group")
  topic         String
  partition     Int
  currentOffset BigInt   @map("current_offset")
  latestOffset  BigInt   @map("latest_offset")
  lagMessages   BigInt   @map("lag_messages")
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@id([consumerGroup, topic, partition])
  @@map("consumer_lag")
}

// =============================================================================
// Retention Policies (Seed script writes, Retention job reads)
// =============================================================================

/// Configures cleanup for each table.
model RetentionPolicy {
  tableName     String    @id @map("table_name")
  retentionDays Int       @map("retention_days")
  enabled       Boolean   @default(true)
  lastCleanupAt DateTime? @map("last_cleanup_at") @db.Timestamptz

  @@map("retention_policies")
}
