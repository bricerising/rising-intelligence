{
  "name": "@rising-intelligence/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Database schema and Prisma client for Rising Intelligence",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "prisma/"
  ],
  "scripts": {
    "build": "node scripts/prisma-generate.mjs && tsc",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio",
    "retention:cleanup": "tsx src/retention-job.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
